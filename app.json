{
  "expo": {
    "name": "Nutri AI",
    "slug": "nutri-ai",
    "scheme": "nutriai",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nutriai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Nutri AI uses the camera to photograph your meals and estimate their calories.",
        "NSPhotoLibraryUsageDescription": "Nutri AI lets you pick a meal photo from your library."
      }
    },
    "android": {
      "package": "com.nutriai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA"
      ],
      "versionCode": 5,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-localization",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Nutri AI uses the camera to photograph your meals and estimate their calories.",
          "photosPermission": "Nutri AI lets you pick a meal photo from your library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "omar-nutris-team",
    "extra": {
      "eas": {
        "projectId": "198f3b44-c7e0-470c-a89d-134d5ad199ee"
      }
    }
  }
}
